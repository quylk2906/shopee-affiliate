# Set to true only for local UI testing. Production must use provider-backed adapters.
AFFILIATE_API_MOCK=false

# Shopee affiliate adapter
SHOPEE_AFFILIATE_API_URL=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Local fallback for the Shopee cookie. Production reads `shoppeCookie` from
# Vercel Global Config.
SHOPEE_COOKIE=

# TikTok Shop affiliate adapter
TIKTOK_AFFILIATE_API_URL=
TIKTOK_AFFILIATE_APP_KEY=
TIKTOK_AFFILIATE_SECRET=
